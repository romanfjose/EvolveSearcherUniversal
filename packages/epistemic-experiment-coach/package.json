{
  "name": "clash-with-reality",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server.mjs\" \"vite\"",
    "build": "vite build && node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "node server.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "capture:cooking-flow": "node docs/cooking-flow/capture-flow.mjs"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "firebase": "^12.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.61.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
